[Unit]
Description=NexNOC device health poller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nexnoc
Group=nexnoc
WorkingDirectory=/opt/nexnoc
EnvironmentFile=-/etc/nexnoc/nexnoc.env
ExecStart=/usr/bin/python3 /opt/nexnoc/poller.py --config /etc/nexnoc/config.json --db /var/lib/nexnoc/noc.db
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nexnoc /var/log/nexnoc
PrivateTmp=true

[Install]
WantedBy=multi-user.target
