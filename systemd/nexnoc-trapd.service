[Unit]
Description=NexNOC SNMP trap listener (v1/v2c UDP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nexnoc
Group=nexnoc
WorkingDirectory=/opt/nexnoc
EnvironmentFile=-/etc/nexnoc/nexnoc.env
ExecStart=/usr/bin/python3 /opt/nexnoc/trapd.py --db /var/lib/nexnoc/noc.db --host 0.0.0.0 --port 162
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nexnoc /var/log/nexnoc
PrivateTmp=true

[Install]
WantedBy=multi-user.target
